#!/bin/bash

# Git Workflow Manager - 简化Git工作流
# 功能：
# 1. gitm create <branch> - 基于最新master创建新分支并切换
# 2. gitm merge <?branch> - 将分支合并到master/main（无merge commit）
# 3. gitm delete <?branch> - 删除已合并的分支

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 主分支检测
MAIN_BRANCHES=("master" "main")
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# 检查当前是否在主分支
is_main_branch() {
    for branch in "${MAIN_BRANCHES[@]}"; do
        if [[ "$CURRENT_BRANCH" == "$branch" ]]; then
            return 0
        fi
    done
    return 1
}

# 获取主分支名称
get_main_branch() {
    for branch in "${MAIN_BRANCHES[@]}"; do
        if git show-ref --verify --quiet refs/heads/$branch; then
            echo $branch
            return 0
        fi
    done
    echo "master"  # 默认返回master
}

# 检查远程仓库是否存在
has_remote() {
    git remote -v | grep -q "origin"
    return $?
}

# 功能1: 创建新分支
create_branch() {
    local branch_name="$1"

    if [[ -z "$branch_name" ]]; then
        echo -e "${RED}错误: 请提供分支名称${NC}"
        echo "用法: gitm create <branch-name>"
        exit 1
    fi

    local main_branch=$(get_main_branch)

    echo -e "${BLUE}正在更新主分支 $main_branch...${NC}"
    git checkout $main_branch
    git pull --rebase origin $main_branch

    echo -e "${BLUE}创建并切换到新分支 $branch_name...${NC}"
    git checkout -b "$branch_name"

    echo -e "${GREEN}✓ 成功创建分支 $branch_name 并基于最新的 $main_branch${NC}"
}

# 功能2: 合并分支到主分支（无merge commit）
merge_branch() {
    local branch_name="$1"
    local main_branch=$(get_main_branch)

    # 确定要合并的分支
    if [[ -z "$branch_name" ]]; then
        if is_main_branch; then
            echo -e "${RED}错误: 在主分支上需要指定要合并的分支名称${NC}"
            echo "用法: gitm merge <branch-name>"
            exit 1
        else
            branch_name="$CURRENT_BRANCH"
        fi
    fi

    # 安全检查
    if [[ "$branch_name" == "$main_branch" ]]; then
        echo -e "${RED}错误: 不能合并主分支到自身${NC}"
        exit 1
    fi

    if ! git show-ref --verify --quiet "refs/heads/$branch_name"; then
        echo -e "${RED}错误: 分支 $branch_name 不存在${NC}"
        exit 1
    fi

    echo -e "${BLUE}开始合并流程...${NC}"

    # 1. 更新主分支
    echo -e "${YELLOW}步骤1: 更新主分支 $main_branch...${NC}"
    git checkout $main_branch
    git pull --rebase origin $main_branch

    # 2. 变基到最新主分支
    echo -e "${YELLOW}步骤2: 将分支 $branch_name 变基到最新 $main_branch...${NC}"
    git checkout "$branch_name"
    if git rebase $main_branch; then
        echo -e "${GREEN}✓ 变基成功${NC}"
    else
        echo -e "${RED}变基过程中出现冲突，请手动解决后运行: git rebase --continue${NC}"
        exit 1
    fi

    # 3. 快速前进合并
    echo -e "${YELLOW}步骤3: 将分支合并到主分支...${NC}"
    git checkout $main_branch
    if git merge --ff-only "$branch_name"; then
        echo -e "${GREEN}✓ 快速前进合并成功${NC}"
    else
        echo -e "${RED}快速前进合并失败，可能不是最新的提交${NC}"
        exit 1
    fi

    # 4. 推送到远程
    echo -e "${YELLOW}步骤4: 推送到远程仓库...${NC}"
    if has_remote; then
        git-push $main_branch
        echo -e "${GREEN}✓ 成功推送到远程${NC}"
    else
        echo -e "${YELLOW}警告: 未检测到远程仓库，跳过推送${NC}"
    fi

    # 5. 更新开发分支
    echo -e "${YELLOW}步骤5: 更新开发分支...${NC}"
    git checkout "$branch_name"
    git rebase $main_branch

    echo -e "${GREEN}✓ 合并流程完成！${NC}"
    echo -e "${GREEN}分支 $branch_name 已成功合并到 $main_branch，无merge commit${NC}"
}

# 功能3: 删除已合并的分支
delete_branch() {
    local branch_name="$1"
    local main_branch=$(get_main_branch)

    # 确定要删除的分支
    if [[ -z "$branch_name" ]]; then
        if is_main_branch; then
            echo -e "${RED}错误: 在主分支上需要指定要删除的分支名称${NC}"
            echo "用法: gitm delete <branch-name>"
            exit 1
        else
            branch_name="$CURRENT_BRANCH"
        fi
    fi

    # 安全检查
    if [[ "$branch_name" == "$main_branch" ]]; then
        echo -e "${RED}错误: 不能删除主分支${NC}"
        exit 1
    fi

    if ! git show-ref --verify --quiet "refs/heads/$branch_name"; then
        echo -e "${RED}错误: 分支 $branch_name 不存在${NC}"
        exit 1
    fi

    echo -e "${BLUE}检查分支 $branch_name 是否可以安全删除...${NC}"

    # 检查是否已合并到主分支
    local merged_commits=$(git log $main_branch..$branch_name --oneline)

    if [[ -z "$merged_commits" ]]; then
        # 所有提交都已合并，安全删除
        echo -e "${GREEN}✓ 分支 $branch_name 的所有提交都已合并到 $main_branch${NC}"

        # 切换到主分支（如果要删除的是当前分支）
        if [[ "$CURRENT_BRANCH" == "$branch_name" ]]; then
            git checkout $main_branch
        fi

        # 删除分支
        git branch -d "$branch_name"
        echo -e "${GREEN}✓ 分支 $branch_name 已删除${NC}"

    else
        # 有未合并的提交
        echo -e "${RED}警告: 分支 $branch_name 有未合并到 $main_branch 的提交${NC}"
        echo -e "${YELLOW}未合并的提交:${NC}"
        echo "$merged_commits"
        echo ""
        echo -e "${YELLOW}如果要强制删除（不推荐），请使用: git branch -D $branch_name${NC}"
        exit 1
    fi
}

# 显示帮助信息
show_help() {
    echo -e "${BLUE}Git Workflow Manager (gitm) - 用法说明${NC}"
    echo ""
    echo "命令:"
    echo "  gitm create <branch>     基于最新master创建新分支并切换"
    echo "  gitm merge <?branch>     将分支合并到master（无merge commit）"
    echo "  gitm delete <?branch>    删除已合并到master的分支"
    echo "  gitm help                显示此帮助信息"
    echo ""
}

# 主函数
main() {
    local command="$1"
    local branch_name="$2"

    case "$command" in
        "create")
            create_branch "$branch_name"
            ;;
        "merge")
            merge_branch "$branch_name"
            ;;
        "delete")
            delete_branch "$branch_name"
            ;;
        "help"|"-h"|"--help"|"")
            show_help
            ;;
        *)
            echo -e "${RED}错误: 未知命令 '$command'${NC}"
            show_help
            exit 1
            ;;
    esac
}

# 脚本入口
main "$@"