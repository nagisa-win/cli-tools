# 获取压缩格式
get_compress_format() {
    local archive="$1"
    local lowername=$(echo "$archive" | tr '[:upper:]' '[:lower:]')

    case "$lowername" in
        *.tar.gz|*.tgz)
            echo "tar.gz"
            ;;
        *.tar.bz2|*.tbz2)
            echo "tar.bz2"
            ;;
        *.tar.xz|*.txz)
            echo "tar.xz"
            ;;
        *.tar.zst)
            echo "tar.zst"
            ;;
        *.tar.lz4)
            echo "tar.lz4"
            ;;
        *.tar)
            echo "tar"
            ;;
        *.gz)
            echo "gz"
            ;;
        *.bz2)
            echo "bz2"
            ;;
        *.xz)
            echo "xz"
            ;;
        *.zst)
            echo "zst"
            ;;
        *.lz4)
            echo "lz4"
            ;;
        *.zip)
            echo "zip"
            ;;
        *.7z)
            echo "7z"
            ;;
        *)
            echo "unknown"
            ;;
    esac
}

# 检查压缩工具
check_compress_tool() {
    local format="$1"

    case "$format" in
        tar)
            # tar 内置
            ;;
        tar.gz|gz)
            if ! command_exists gzip; then
                error "未找到 gzip"
                echo "安装建议: $(get_install_suggestion gzip)"
                return 1
            fi
            ;;
        tar.bz2|bz2)
            if ! command_exists bzip2; then
                error "未找到 bzip2"
                echo "安装建议: $(get_install_suggestion bzip2)"
                return 1
            fi
            ;;
        tar.xz|xz)
            if ! command_exists xz; then
                error "未找到 xz"
                echo "安装建议: $(get_install_suggestion xz)"
                return 1
            fi
            ;;
        tar.zst|zst)
            if ! command_exists zstd; then
                error "未找到 zstd"
                echo "安装建议: $(get_install_suggestion zstd)"
                return 1
            fi
            ;;
        tar.lz4|lz4)
            if ! command_exists lz4; then
                error "未找到 lz4"
                echo "安装建议: $(get_install_suggestion lz4)"
                return 1
            fi
            ;;
        zip)
            if ! command_exists zip; then
                error "未找到 zip"
                echo "安装建议: $(get_install_suggestion zip)"
                return 1
            fi
            ;;
        7z)
            if ! command_exists 7z && ! command_exists 7za; then
                error "未找到 7z"
                echo "安装建议: $(get_install_suggestion p7zip)"
                return 1
            fi
            ;;
        *)
            error "不支持的格式: $format"
            return 1
            ;;
    esac

    return 0
}

# 获取排除模式
get_exclude_patterns() {
    local os=$(detect_os)
    local patterns=()

    # 通用排除 - 仅排除真正的缓存/临时文件
    # 注意: .git, node_modules, .svn, .hg 等是项目必要文件，不应排除
    patterns+=(
        "--exclude=*.pyc"
        "--exclude=__pycache__"
        "--exclude=.DS_Store"
        "--exclude=Thumbs.db"
        "--exclude=*.swp"
        "--exclude=*.swo"
        "--exclude=*~"
        "--exclude=.cache"
        "--exclude=.tmp"
        "--exclude=*.tmp"
    )

    # macOS 特定排除 - 系统生成的元数据文件
    if [[ "$os" == "macos" ]]; then
        patterns+=(
            "--exclude=._*"
            "--exclude=.fseventsd"
            "--exclude=.Spotlight-V100"
            "--exclude=.Trashes"
        )
    fi

    echo "${patterns[@]}"
}

# 执行压缩
do_compress() {
    local source_dir="$1"
    local archive="$2"
    local format="$3"

    info "正在压缩 $source_dir 到 $archive"

    # 获取排除模式
    local excludes=$(get_exclude_patterns)

    case "$format" in
        tar)
            eval tar -cf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
            ;;
        tar.gz)
            eval tar -czf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
            ;;
        tar.bz2)
            eval tar -cjf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
            ;;
        tar.xz)
            eval tar -cJf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
            ;;
        tar.zst)
            eval tar --zstd -cf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
            ;;
        tar.lz4)
            # tar.lz4 需要管道方式
            local excludes_str=""
            for p in $excludes; do
                excludes_str="$excludes_str $p"
            done
            eval tar -cf - $excludes_str -C "$(dirname "$source_dir")" "$(basename "$source_dir")" | lz4 > "$archive"
            ;;
        zip)
            # zip 的排除语法不同
            local zip_excludes=()
            for p in $excludes; do
                if [[ "$p" =~ ^--exclude=(.*)$ ]]; then
                    zip_excludes+=("-x" "${BASH_REMATCH[1]}")
                fi
            done
            cd "$(dirname "$source_dir")"
            zip -r "$archive" "$(basename "$source_dir")" "${zip_excludes[@]}" > /dev/null
            cd - > /dev/null
            ;;
        7z)
            if command_exists 7z; then
                7z a "$archive" "$source_dir" > /dev/null
            else
                7za a "$archive" "$source_dir" > /dev/null
            fi
            ;;
        gz|bz2|xz|zst|lz4)
            # 单文件压缩 - 只能压缩单个文件，这里打包整个目录
            warn "格式 .$format 仅支持单文件压缩，将创建 .tar.$format 归档"
            local new_archive="${archive%.*}.tar.${format}"
            archive="$new_archive"
            case "$format" in
                gz)
                    eval tar -czf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
                    ;;
                bz2)
                    eval tar -cjf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
                    ;;
                xz)
                    eval tar -cJf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
                    ;;
                zst)
                    eval tar --zstd -cf "$archive" $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")"
                    ;;
                lz4)
                    eval tar -cf - $excludes -C "$(dirname "$source_dir")" "$(basename "$source_dir")" | lz4 > "$archive"
                    ;;
            esac
            ;;
    esac
}

# 压缩主函数
compress() {
    local source_dir="$1"
    local archive="$2"

    # 检查源目录是否存在
    if [[ ! -e "$source_dir" ]]; then
        error "路径不存在: $source_dir"
        return 1
    fi

    # 只支持目录
    if [[ ! -d "$source_dir" ]]; then
        error "只支持压缩目录，不支持单文件: $source_dir"
        return 1
    fi

    # 获取压缩格式
    local format=$(get_compress_format "$archive")

    if [[ "$format" == "unknown" ]]; then
        error "无法识别压缩格式，请使用明确的扩展名，如: .tar.gz, .zip, .7z"
        return 1
    fi

    info "目标格式: $format"

    # 检查压缩工具
    if ! check_compress_tool "$format"; then
        return 1
    fi

    # 处理同名压缩包
    if [[ -f "$archive" ]]; then
        warn "压缩包已存在: $archive"
        echo "请选择:"
        echo "  1. 输入新文件名"
        echo "  2. 退出"
        read -p "选择 [1/2]: " choice

        case "$choice" in
            1)
                read -p "输入新的文件名: " new_archive
                if [[ -z "$new_archive" ]]; then
                    error "文件名不能为空"
                    return 1
                fi
                archive="$new_archive"
                ;;
            *)
                info "操作已取消"
                return 0
                ;;
        esac
    fi

    # 执行压缩
    if do_compress "$source_dir" "$archive" "$format"; then
        success "压缩完成: $archive"

        # 删除源目录
        if $DELETE_SOURCE; then
            warn "即将删除源目录: $source_dir"
            if confirm "确认删除?" "n"; then
                rm -rf "$source_dir"
                success "已删除源目录: $source_dir"
            else
                info "跳过删除"
            fi
        fi

        return 0
    else
        error "压缩失败"
        return 1
    fi
}

# ============================================================================
# 列出压缩包内容
# ============================================================================

list_archive() {
    local file="$1"

    # 检查文件是否存在
    if [[ ! -f "$file" ]]; then
        error "文件不存在: $file"
        return 1
    fi

    # 检测格式
    local format=$(detect_format "$file")

    if [[ "$format" == "unknown" ]]; then
        error "无法识别文件格式: $file"
        return 1
    fi

    info "格式: $format"
    echo ""

    case "$format" in
        tar)
            tar -tf "$file"
            ;;
        tar.gz|tgz)
            tar -tzf "$file"
            ;;
        tar.bz2|tbz2)
            tar -tjf "$file"
            ;;
        tar.xz|txz)
            tar -tJf "$file"
            ;;
        tar.zst)
            tar --zstd -tf "$file"
            ;;
        tar.lz4)
            lz4 -d -c "$file" | tar -tf -
            ;;
        zip)
            unzip -l "$file"
            ;;
        7z)
            if command_exists 7z; then
                7z l "$file"
            else
                7za l "$file"
            fi
            ;;
        rar)
            if command_exists unrar; then
                unrar l "$file"
            else
                rar l "$file"
            fi
            ;;
        gz|bz2|xz|zst|lz4)
            # 单文件压缩，列出本身
            info "单文件压缩格式，只包含一个文件:"
            basename "$file" | sed "s/\.${format}$//"
            ;;
        deb)
            ar -t "$file"
            ;;
        rpm)
            rpm2cpio "$file" | cpio -t
            ;;
        asar)
            asar list "$file"
            ;;
        *)
            error "不支持列出此格式: $format"
            return 1
            ;;
    esac
}

# ============================================================================
# 测试压缩包完整性
# ============================================================================

test_archive() {
    local file="$1"

    # 检查文件是否存在
    if [[ ! -f "$file" ]]; then
        error "文件不存在: $file"
        return 1
    fi

    # 检测格式
    local format=$(detect_format "$file")

    if [[ "$format" == "unknown" ]]; then
        error "无法识别文件格式: $file"
        return 1
    fi

    info "格式: $format"
    info "正在测试完整性..."

    case "$format" in
        tar)
            tar -tf "$file" > /dev/null 2>&1
            ;;
        tar.gz|tgz)
            tar -tzf "$file" > /dev/null 2>&1
            ;;
        tar.bz2|tbz2)
            tar -tjf "$file" > /dev/null 2>&1
            ;;
        tar.xz|txz)
            tar -tJf "$file" > /dev/null 2>&1
            ;;
        tar.zst)
            tar --zstd -tf "$file" > /dev/null 2>&1
            ;;
        tar.lz4)
            lz4 -d -c "$file" | tar -tf - > /dev/null 2>&1
            ;;
        zip)
            if command_exists unzip; then
                unzip -t "$file" > /dev/null 2>&1
            else
                warn "未找到 unzip，跳过测试"
                return 1
            fi
            ;;
        7z)
            if command_exists 7z; then
                7z t "$file" > /dev/null 2>&1
            else
                7za t "$file" > /dev/null 2>&1
            fi
            ;;
        rar)
            if command_exists unrar; then
                unrar t "$file" > /dev/null 2>&1
            else
                rar t "$file" > /dev/null 2>&1
            fi
            ;;
        gz)
            gzip -t "$file" 2>&1
            ;;
        bz2)
            bzip2 -t "$file" 2>&1
            ;;
        xz)
            xz -t "$file" 2>&1
            ;;
        zst)
            zstd -t "$file" 2>&1
            ;;
        lz4)
            lz4 -t "$file" 2>&1
            ;;
        deb)
            ar -t "$file" > /dev/null 2>&1
            ;;
        rpm)
            rpm -K "$file" > /dev/null 2>&1
            ;;
        asar)
            asar list "$file" > /dev/null 2>&1
            ;;
        *)
            error "不支持测试此格式: $format"
            return 1
            ;;
    esac

    if [[ $? -eq 0 ]]; then
        success "压缩包完整，无错误"
        return 0
    else
        error "压缩包可能已损坏"
        return 1
    fi
}

# ============================================================================
# 主函数
# ============================================================================

main() {
    if [[ $# -lt 1 ]]; then
        show_help
        exit 0
    fi

    local action=""
    local source=""
    local target=""

    # 解析参数
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                echo "pakm v${VERSION}"
                exit 0
                ;;
            -d)
                DELETE_SOURCE=true
                shift
                ;;
            -o|--overwrite)
                OVERWRITE=true
                shift
                ;;
            -k|--keep)
                KEEP_ARCHIVE=true
                shift
                ;;
            -f|--force)
                OVERWRITE=true
                shift
                ;;
            -s|--no-smart)
                SMART_EXTRACT=false
                shift
                ;;
            x|c|l|t)
                action="$1"
                shift
                ;;
            *)
                if [[ -z "$source" ]]; then
                    source="$1"
                elif [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    # 执行操作
    case "$action" in
        x)
            if [[ -z "$source" ]]; then
                error "请指定要解压的文件"
                show_help
                exit 1
            fi
            extract "$source" "$target"
            ;;
        c)
            if [[ -z "$source" ]]; then
                error "请指定要压缩的目录"
                show_help
                exit 1
            fi
            if [[ -z "$target" ]]; then
                error "请指定压缩包名称"
                show_help
                exit 1
            fi
            compress "$source" "$target"
            ;;
        l)
            if [[ -z "$source" ]]; then
                error "请指定要列出的压缩包"
                show_help
                exit 1
            fi
            list_archive "$source"
            ;;
        t)
            if [[ -z "$source" ]]; then
                error "请指定要测试的压缩包"
                show_help
                exit 1
            fi
            test_archive "$source"
            ;;
        *)
            error "未知操作: $action"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
